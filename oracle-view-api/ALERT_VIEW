--------------------------------------------------------------------------------
-- 1. Drop the Scheduler job if it already exists
--------------------------------------------------------------------------------
BEGIN
    DBMS_SCHEDULER.DROP_JOB(
        job_name => 'LC_SCMT.VW_ALERT_REPORTER_CH_PBI',
        force    => TRUE
    );
EXCEPTION
    WHEN OTHERS THEN
        IF SQLCODE != -27475 THEN
            RAISE;
        END IF;
END;
/

--------------------------------------------------------------------------------
-- 2. Create the Scheduler job
--    Refreshes the materialized view Monday-Friday at 23:00
--------------------------------------------------------------------------------
BEGIN
    DBMS_SCHEDULER.CREATE_JOB(
        job_name            => 'LC_SCMT.VW_ALERT_REPORTER_CH_PBI',
        job_type            => 'PLSQL_BLOCK',
        job_action          => q'[
            BEGIN
                DBMS_MVIEW.REFRESH(
                    list   => 'LC_SCMT.VW_ALERT_REPORTER_CH_PBI',
                    method => 'C'
                );
            END;
        ]',
        start_date          => SYSTIMESTAMP,
        repeat_interval     => 'FREQ=WEEKLY;BYDAY=MON,TUE,WED,THU,FRI;BYHOUR=23;BYMINUTE=0;BYSECOND=0',
        end_date            => NULL,
        job_class           => 'DEFAULT_JOB_CLASS',
        enabled             => FALSE,
        auto_drop           => FALSE,
        comments            => 'Refresh LC_SCMT.VW_ALERT_REPORTER_CH_PBI every working day at 23:00'
    );
END;
/

--------------------------------------------------------------------------------
-- 3. Enable the Scheduler job
--------------------------------------------------------------------------------
BEGIN
    DBMS_SCHEDULER.ENABLE(
        name => 'LC_SCMT.VW_ALERT_REPORTER_CH_PBI'
    );
END;
/
