Step 1 — Stop Tomcat 10

systemctl stop vfvb-vw-AT35959-dev-T10-FCSCMT.tomcat.service

Verify

systemctl is-active vfvb-vw-AT35959-dev-T10-FCSCMT.tomcat.service
ps -ef | grep '[o]rg.apache.catalina.startup.Bootstrap'

Step 2 — Define and verify the instance path
T10_BASE=/app/web/dyn/tomcat/config/instances/vfvb-vw-AT35959-dev-T10-FCSCMT/servers/server1
export T10_BASE

ls -ld "$T10_BASE"

Then locate deployed applications and configuration:
find "$T10_BASE" -maxdepth 5 \
  \( -type f -o -type l \) \
  \( -iname 'acm.ini' -o -iname 'RCM.war' -o -iname '*RCM*' \) \
  -ls 2>/dev/null

find "$T10_BASE" -maxdepth 3 -type d -print 2>/dev/null | sort

Step 3 — Inspect the actual service configuration

systemctl cat vfvb-vw-AT35959-dev-T10-FCSCMT.tomcat.service

systemctl show vfvb-vw-AT35959-dev-T10-FCSCMT.tomcat.service \
  -p FragmentPath \
  -p User \
  -p Group \
  -p Environment \
  -p ExecStart \
  -p ExecStop
