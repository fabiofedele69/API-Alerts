    LogFormat "%h %t \"%r\" %>s VERIFY=%{SSL_CLIENT_VERIFY}x DN=\"%{SSL_CLIENT_S_DN}x\" ISSUER=\"%{SSL_CLIENT_I_DN}x\" SERIAL=\"%{SSL_CLIENT_M_SERIAL}x\"" ssl_debug

