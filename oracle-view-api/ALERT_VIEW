--------------------------------------------------------------------------------
-- RESET AND RECREATE:
--   1. Scheduler job
--   2. Materialized view
--   3. SELECT grant
--   4. Scheduler refresh job
--------------------------------------------------------------------------------

SET SERVEROUTPUT ON;

--------------------------------------------------------------------------------
-- 1. DROP THE SCHEDULER JOB IF IT EXISTS
--------------------------------------------------------------------------------

BEGIN
    DBMS_SCHEDULER.DROP_JOB(
        job_name => 'LC_SCMT.VW_ALERT_REPORTER_CH_PBI',
        force    => TRUE
    );

    DBMS_OUTPUT.PUT_LINE('Scheduler job dropped.');
EXCEPTION
    WHEN OTHERS THEN
        -- ORA-27475: job does not exist
        IF SQLCODE = -27475 THEN
            DBMS_OUTPUT.PUT_LINE('Scheduler job does not exist. Nothing to drop.');
        ELSE
            RAISE;
        END IF;
END;
/

--------------------------------------------------------------------------------
-- 2. DROP THE MATERIALIZED VIEW IF IT EXISTS
--------------------------------------------------------------------------------

BEGIN
    EXECUTE IMMEDIATE
        'DROP MATERIALIZED VIEW LC_SCMT.VW_ALERT_REPORTER_CH_PBI';

    DBMS_OUTPUT.PUT_LINE('Materialized view dropped.');
EXCEPTION
    WHEN OTHERS THEN
        -- ORA-12003: materialized view does not exist
        -- ORA-00942: table or view does not exist
        IF SQLCODE IN (-12003, -942) THEN
            DBMS_OUTPUT.PUT_LINE(
                'Materialized view does not exist. Nothing to drop.'
            );
        ELSE
            RAISE;
        END IF;
END;
/

--------------------------------------------------------------------------------
-- 3. CREATE THE MATERIALIZED VIEW
--------------------------------------------------------------------------------

CREATE MATERIALIZED VIEW LC_SCMT.VW_ALERT_REPORTER_CH_PBI
TABLESPACE FCSMT_TBLSP
PCTFREE 10
INITRANS 2
MAXTRANS 255
STORAGE
(
    INITIAL     80K
    NEXT        1M
    MINEXTENTS  1
    MAXEXTENTS  UNLIMITED
    PCTINCREASE 0
)
NOCACHE
LOGGING
NOCOMPRESS
BUILD IMMEDIATE
REFRESH COMPLETE ON DEMAND
AS
SELECT /*+ PARALLEL(5) */
       *
FROM LC_SCMT.VW_API_REPORTER;
    
--------------------------------------------------------------------------------
-- 4. GRANT ACCESS TO THE POWER BI USER/SCHEMA
--------------------------------------------------------------------------------

GRANT SELECT
ON LC_SCMT.VW_ALERT_REPORTER_CH_PBI
TO LC_SCMT_PBI;

--------------------------------------------------------------------------------
-- 5. CREATE THE REFRESH JOB
--
-- Runs Monday-Friday at 23:00.
--------------------------------------------------------------------------------

BEGIN
    DBMS_SCHEDULER.CREATE_JOB(
        job_name        => 'LC_SCMT.VW_ALERT_REPORTER_CH_PBI',
        job_type        => 'PLSQL_BLOCK',
        job_action      => q'[
            BEGIN
                DBMS_MVIEW.REFRESH(
                    list   => 'LC_SCMT.VW_ALERT_REPORTER_CH_PBI',
                    method => 'C'
                );
            END;
        ]',
        number_of_arguments => 0,
        start_date          => SYSTIMESTAMP,
        repeat_interval     =>
            'FREQ=WEEKLY;' ||
            'BYDAY=MON,TUE,WED,THU,FRI;' ||
            'BYHOUR=23;' ||
            'BYMINUTE=0;' ||
            'BYSECOND=0',
        end_date            => NULL,
        job_class           => 'DEFAULT_JOB_CLASS',
        enabled             => TRUE,
        auto_drop           => FALSE,
        comments            =>
            'Complete refresh of LC_SCMT.VW_ALERT_REPORTER_CH_PBI'
    );

    DBMS_OUTPUT.PUT_LINE('Scheduler job created and enabled.');
END;
/

COMMIT;

--------------------------------------------------------------------------------
-- 6. VALIDATION
--------------------------------------------------------------------------------

PROMPT ============================================================
PROMPT Materialized view status
PROMPT ============================================================

SELECT owner,
       mview_name,
       refresh_mode,
       refresh_method,
       build_mode,
       last_refresh_type,
       last_refresh_date,
       staleness
FROM all_mviews
WHERE owner = 'LC_SCMT'
  AND mview_name = 'VW_ALERT_REPORTER_CH_PBI';

PROMPT ============================================================
PROMPT Scheduler job status
PROMPT ============================================================

SELECT owner,
       job_name,
       enabled,
       state,
       start_date,
       repeat_interval,
       last_start_date,
       next_run_date,
       failure_count
FROM all_scheduler_jobs
WHERE owner = 'LC_SCMT'
  AND job_name = 'VW_ALERT_REPORTER_CH_PBI';

PROMPT ============================================================
PROMPT Materialized view row count
PROMPT ============================================================

SELECT COUNT(*) AS ROW_COUNT
FROM LC_SCMT.VW_ALERT_REPORTER_CH_PBI;
