4. Compare the working and vendor acm.ini parameter sets

awk -F= '
  /^[[:space:]]*[#;]/ {next}
  /^[[:space:]]*$/ {next}
  /=/ {
    key=$1
    gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
    print key
  }
' /app/rhel8_migration/RCM/acm.ini \
  | sort -u > /tmp/acm_working.keys

echo "In working copy but not vendor baseline:"
comm -23 /tmp/acm_working.keys /tmp/acm_vendor_10_2.keys

echo "In vendor baseline but missing from working copy:"
comm -13 /tmp/acm_working.keys /tmp/acm_vendor_10_2.keys

